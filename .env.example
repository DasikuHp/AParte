PORT=3000

# Obligatorio en producción. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# true = datos ficticios, contraseña demo1234 y los correos no se envían
DEMO_MODE=false

# Técnicos: copia config/tecnicos.example.json a config/tecnicos.json
# TECNICOS_FILE=config/tecnicos.json
# DB_PATH=data/partes.db
# UPLOADS_DIR=uploads

# Detrás de un proxy con HTTPS (Nginx, Render...): cookies seguras
# COOKIE_SECURE=true
# TRUST_PROXY=true

# SMTP (si se deja SMTP_HOST vacío, los correos no se envían)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
